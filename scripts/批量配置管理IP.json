{
  "script_name": "批量配置管理IP",
  "description": "批量配置设备主机名、管理接口 IP 地址、开启 LLDP",
  "command_template": "sysname {{hostname}}\ninterface {{interface}}\nip address {{ip_address}} {{subnet_mask}}\nquit\nlldp enable",
  "global_vars": {
    "subnet_mask": "255.255.255.0"
  },
  "sample_device_vars": {
    "192.168.56.11": {
      "hostname": "AR1",
      "interface": "GigabitEthernet0/0/0",
      "ip_address": "192.168.56.11"
    },
    "192.168.56.12": {
      "hostname": "AR2",
      "interface": "GigabitEthernet0/0/0",
      "ip_address": "192.168.56.12"
    }
  },
  "verify_commands": [
    "display ip interface brief",
    "display current-configuration | include sysname"
  ],
  "created_at": "2026-06-05 20:00:00",
  "updated_at": "2026-06-05 20:00:00"
}
